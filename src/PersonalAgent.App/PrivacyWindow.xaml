<Window x:Class="PersonalAgent.App.PrivacyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy and history" Width="560" Height="460" MinWidth="480" MinHeight="350" ShowActivated="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="History retention" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock TextWrapping="Wrap" Text="Clears private text, sources and saved sessions from conversations whose tasks all finished before the selected period. Unfinished tasks, pending approvals and uncertain outcomes are kept. Task identities and protections against duplicate actions remain."/>
        <CheckBox Content="Enable automatic expiry" IsChecked="{Binding Enabled}" Margin="0,14,0,10"/>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Keep at least (days):" VerticalAlignment="Center"/>
            <TextBox x:Name="RetentionDays" Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="12,0,0,0"/>
        </StackPanel>
        <WrapPanel Margin="0,16,0,10">
            <Button Content="Reload" Command="{Binding ReloadCommand}" Padding="12,5" Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="12,5" Margin="0,0,8,0"/>
            <Button x:Name="ClearExpiredHistory" Content="Clear expired content now" Command="{Binding ClearCommand}" Padding="12,5"/>
        </WrapPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="Screenshots are not saved by default. Cleanup updates this history store; separate backups and external copies are outside its scope."/>
    </StackPanel>
    </ScrollViewer>
</Window>
