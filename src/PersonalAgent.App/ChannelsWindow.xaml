<Window x:Class="PersonalAgent.App.ChannelsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Channels" Width="860" Height="710" ShowActivated="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Connect a channel" FontSize="22" Margin="0,0,0,12"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
                <ListBox x:Name="ConnectionsList" ItemsSource="{Binding Connections}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" Height="300" IsEnabled="{Binding CanEdit}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="New" Command="{Binding NewCommand}" Padding="12,5"/><Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0" Padding="12,5"/></StackPanel>
                <TextBlock Text="For a new token or recipient, disable the old connection and create a new one." TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="1. Save the channel disabled" FontWeight="Bold"/>
                    <TextBlock Text="Name" Margin="0,8,0,2"/><TextBox x:Name="ChannelName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Channel" Margin="0,8,0,2"/><ComboBox x:Name="ChannelKind" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" IsEnabled="{Binding CanChangeIdentity}"/>
                    <TextBlock Text="Telegram bot token (new connection only)" Margin="0,8,0,2"/><PasswordBox x:Name="BotToken" PasswordChanged="TokenChanged" IsEnabled="{Binding CanChangeIdentity}"/>
                    <TextBlock Text="Telegram chat ID (Desktop uses the current Windows owner)" Margin="0,8,0,2"/><TextBox x:Name="ChatId" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeIdentity}"/>
                    <TextBlock Text="Telegram user ID allowed in this chat" Margin="0,8,0,2"/><TextBox x:Name="SenderId" Text="{Binding Sender, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeIdentity}"/>
                    <TextBlock Text="2. Test the saved token; authorize the exact user/chat" FontWeight="Bold" Margin="0,16,0,8"/>
                    <Button x:Name="TestChannel" Content="Test saved connection" Command="{Binding TestCommand}" HorizontalAlignment="Left" Padding="12,5"/>
                    <CheckBox x:Name="AuthorizePeer" Content="I authorize this exact user/chat (or this local Desktop)" IsChecked="{Binding AuthorizePeer}" Margin="0,10,0,0"/>
                    <TextBlock Text="3. Select future notifications and enable" FontWeight="Bold" Margin="0,16,0,8"/>
                    <ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Kind}" IsChecked="{Binding Selected}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <CheckBox x:Name="ReceiveTasks" Content="Receive Telegram tasks and commands" IsChecked="{Binding ReceiveTasks}" Margin="0,10,0,0"/>
                    <CheckBox x:Name="ChannelEnabled" Content="Enable this channel" IsChecked="{Binding Enabled}" Margin="0,8,0,8"/>
                    <Button x:Name="SaveChannel" Content="Save settings and peer decision" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Padding="12,5"/>
                    <TextBlock Text="{Binding SaveState}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="ChannelMessage" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,14,0,0"/>
    </Grid>
</Window>
