<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../TestDoubles/*.cs" Link="TestDoubles/%(Filename)%(Extension)" />
    <Compile Include="../PersonalAgent.WindowsSmoke/AttendedPause.cs" Link="Fixture/AttendedPause.cs" />
    <Compile Include="../PersonalAgent.WindowsSmoke/RegressionWindow.cs" Link="Fixture/RegressionWindow.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PersonalAgent.App/PersonalAgent.App.csproj" />
    <ProjectReference Include="../PersonalAgent.McpTestServer/PersonalAgent.McpTestServer.csproj" />
    <ProjectReference Include="../PersonalAgent.RecoveryTestProcess/PersonalAgent.RecoveryTestProcess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
