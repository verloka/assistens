<Window x:Class="PersonalAgent.App.TaskToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose tools for one task" Width="760" Height="570" MinWidth="560" MinHeight="400" ShowActivated="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                <DataTrigger Binding="{Binding Tag.IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
            </Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="Tools for this task" FontSize="22" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,12,0,0">
                <Button x:Name="RefreshTaskTools" Content="Refresh available tools" Command="{Binding RefreshCommand}" Padding="10,4" Margin="0,0,8,8"/>
                <Button Content="Clear selection" Command="{Binding ClearCommand}" Padding="10,4" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="Only selected tools are sent to the chosen model. Captures may disclose desktop content. Review exact sensitive actions in Approvals. GUI input is refused if the screen changes while approval waits. No tools carry over to the next task or a remote reply." TextWrapping="Wrap" Margin="0,0,0,12"/>
            <ItemsControl x:Name="TaskToolChoices" ItemsSource="{Binding Choices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Margin="22,4,0,4">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding NeedsTargets}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></StackPanel.Style>
                                <TextBlock Text="Exact MCP targets (JSON). Example: [{&quot;JsonPointer&quot;:&quot;/ticketId&quot;,&quot;AllowedValues&quot;:[&quot;TEST-1&quot;]}]. Empty rules deny mutations." TextWrapping="Wrap"/>
                                <TextBox Text="{Binding TargetsJson, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Close this window and press Start task to use this one selection. Refresh, Clear, a profile/history change or a submission clears it. Unavailable or changed tools fail closed." TextWrapping="Wrap" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
