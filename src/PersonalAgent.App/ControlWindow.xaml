<Window x:Class="PersonalAgent.App.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Agent controls" Icon="/PersonalAgent.App;component/Assets/agent.ico" Width="440" SizeToContent="Height"
        ResizeMode="CanMinimize" ShowActivated="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="ControlStatus" Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding RunTitle}" TextTrimming="CharacterEllipsis" MaxHeight="44" Margin="0,8" />
        <TextBlock Text="{Binding Progress}" TextTrimming="CharacterEllipsis" />
        <WrapPanel Margin="0,12">
            <Button x:Name="TakeControlButton" Content="Pause &amp; Take Control" Command="{Binding TakeControlCommand}" Padding="8,6" />
            <Button x:Name="ControlResumeButton" Content="Resume" Command="{Binding ResumeCommand}" Padding="8,6" Margin="8,0" />
            <Button x:Name="ControlCancelButton" Content="Cancel" Command="{Binding CancelCommand}" Padding="8,6" />
        </WrapPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </StackPanel>
</Window>
