<Window x:Class="PersonalAgent.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings transfer and backups" Width="700" Height="510" MinWidth="560" MinHeight="400" ShowActivated="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
        <TextBlock Text="Start with Windows" FontSize="22" FontWeight="SemiBold"/>
        <StackPanel IsEnabled="{Binding StartupAvailable}" Margin="0,12">
            <CheckBox x:Name="LoginStartupCheckBox" Content="Start Personal Agent when I sign in (this Windows user only)" IsChecked="{Binding LoginStartupEnabled}"/>
            <WrapPanel Margin="0,8">
                <Button x:Name="ReloadLoginStartup" Content="Reload startup setting" Click="ReloadStartupClicked" Padding="12,5" Margin="0,0,8,0"/>
                <Button x:Name="SaveLoginStartup" Content="Save startup choice" Click="SaveStartupClicked" Padding="12,5"/>
            </WrapPanel>
            <TextBlock Text="{Binding StartupMessage}" TextWrapping="Wrap"/>
            <TextBlock Text="Off on a fresh profile. Changes take effect only after Save. This opens the normal app at sign-in; it grants no automation permissions. Tray Exit stops this session; disable startup here before moving/removing the installed folder." TextWrapping="Wrap" Margin="0,8,0,12"/>
        </StackPanel>
        <TextBlock Text="Settings export / import" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Margin="0,12" Text="Export contains no protected credentials, references, history or approvals. Task text and MCP arguments/URL path/query are omitted. Import requires matching local model credentials; it adds disabled connections/schedules with no permissions. Model settings and retention period update locally; automatic retention stays off. Restart after import."/>
        <WrapPanel IsEnabled="{Binding Available}">
            <Button Content="Export settings…" Click="ExportClicked" Padding="12,5" Margin="0,0,8,8"/>
            <Button Content="Open import…" Click="LoadClicked" Padding="12,5" Margin="0,0,8,8"/>
            <Button x:Name="ApplyImportedSettings" Content="Apply reviewed import" IsEnabled="{Binding CanApply}" Click="ApplyClicked" Padding="12,5" Margin="0,0,8,8"/>
            <Button Content="Create private DB backup" Click="BackupClicked" Padding="12,5" Margin="0,0,8,8"/>
        </WrapPanel>
        <TextBlock x:Name="SettingsPreview" Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,12"/>
        <TextBlock x:Name="SettingsMessage" Text="{Binding Message}" TextWrapping="Wrap"/>
        <TextBlock TextWrapping="Wrap" Margin="0,16,0,0" Text="Database backups contain private history and stay beside the local DB in its .backups directory. They exclude the separate protected secret store. Pending upgrades require a verified backup. Backups are never automatically restored; old copies may lack later action receipts. Keep them private and review real-world effects before restoring manually."/>
    </StackPanel>
    </ScrollViewer>
</Window>
