<Window x:Class="PersonalAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PersonalAgent.App"
        mc:Ignorable="d"
        Title="Personal Agent" Icon="/PersonalAgent.App;component/Assets/agent.ico"
        Height="800" Width="900" MinHeight="600" MinWidth="650" ShowActivated="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button x:Name="PrivacyButton" DockPanel.Dock="Right" Content="Privacy" Click="OpenPrivacyClicked" Padding="12,5" Margin="0,0,8,0" />
            <Button x:Name="ChannelsButton" DockPanel.Dock="Right" Content="Channels" Click="OpenChannelsClicked" Padding="12,5" Margin="0,0,8,0" />
            <Button x:Name="SchedulesButton" DockPanel.Dock="Right" Content="Schedules" Click="OpenSchedulesClicked" Padding="12,5" Margin="0,0,8,0" />
            <Button x:Name="ModelsButton" DockPanel.Dock="Right" Content="Models" Click="OpenModelsClicked" Padding="12,5" />
            <Button x:Name="McpConnectionsButton" DockPanel.Dock="Right" Content="MCP" Click="OpenMcpClicked" Padding="12,5" Margin="0,0,8,0" />
            <Button x:Name="ApprovalsButton" DockPanel.Dock="Right" Content="Approvals" Click="OpenApprovalsClicked" Padding="12,5" Margin="0,0,8,0" />
            <TextBlock Text="Personal Agent" FontSize="26" FontWeight="SemiBold" />
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,16">
            <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="Gray" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HostStatus}" Value="Running">
                                <Setter Property="Fill" Value="ForestGreen" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HostStatus}" Value="Stopping">
                                <Setter Property="Fill" Value="DarkOrange" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="Host: " FontWeight="SemiBold" />
            <TextBlock x:Name="HostStatusText" Text="{Binding HostStatus}" />
            <Button x:Name="DesktopRequestsButton" Content="Desktop requests" Click="OpenDesktopRequestsClicked" Padding="10,4" Margin="16,0,0,0" />
        </StackPanel>
        <GroupBox Grid.Row="2" Header="Registered hosted components" Height="90" Padding="12" Margin="0,0,0,16">
            <ListBox x:Name="ComponentsList" ItemsSource="{Binding Components}" BorderThickness="0" />
        </GroupBox>
        <StackPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="CloseToTrayCheckBox" Content="Keep running in tray when closing" VerticalAlignment="Center" />
                <Button x:Name="OpenControlsButton" Content="Controls" Padding="10,4" Margin="12,0" />
            </StackPanel>
            <Button x:Name="DiagnosticButton" Content="Run test operation (5 seconds)"
                    Command="{Binding RunDiagnosticCommand}" HorizontalAlignment="Left" Padding="12,6" />
            <ProgressBar Height="4" Margin="0,12,0,8" IsIndeterminate="{Binding IsBusy}" />
            <TextBlock x:Name="DiagnosticStatusText" Text="{Binding DiagnosticStatus}" TextWrapping="Wrap" />
        </StackPanel>
        <GroupBox Grid.Row="4" Header="Task" DataContext="{Binding Dashboard}" Padding="12" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <local:ModelProfilesControl x:Name="ModelsPanel" DataContext="{Binding Profiles}" />
                    <CheckBox x:Name="ContinueConversation" Content="Continue the selected task conversation"
                              IsChecked="{Binding ContinueConversation}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,8" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Task history: " VerticalAlignment="Center" />
                    <ComboBox x:Name="RunHistoryList" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}"
                              DisplayMemberPath="Instructions" MinWidth="250" MaxWidth="600">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                    <Button x:Name="RefreshTaskHistory" Content="Refresh" Command="{Binding RefreshHistoryCommand}" Margin="8,0,0,0" Padding="10,3" />
                </StackPanel>
                <TextBox x:Name="TaskInstructions" Grid.Row="2" Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinHeight="48" TextWrapping="Wrap" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8">
                    <Button x:Name="SubmitTaskButton" Content="Start task" Command="{Binding SubmitCommand}" Padding="10,5" Margin="0,0,8,0" />
                    <Button x:Name="PauseTaskButton" Content="Pause task" Command="{Binding PauseCommand}" Padding="10,5" Margin="0,0,8,0" />
                    <Button x:Name="ResumeTaskButton" Content="Resume" Command="{Binding ResumeCommand}" Padding="10,5" Margin="0,0,8,0" />
                    <Button x:Name="CancelTaskButton" Content="Cancel" Command="{Binding CancelCommand}" Padding="10,5" />
                </StackPanel>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Status: " FontWeight="SemiBold" />
                    <TextBlock x:Name="RunStatusText" Text="{Binding Status}" />
                </StackPanel>
                <ListBox x:Name="RunEventsList" Grid.Row="5" ItemsSource="{Binding Events}" DisplayMemberPath="Message" />
                <StackPanel Grid.Row="6" Margin="0,8,0,0">
                    <TextBlock x:Name="RunSummaryText" Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock x:Name="RunWarningsText" Text="{Binding Warnings}" TextWrapping="Wrap" Foreground="DarkOrange" />
                    <TextBlock x:Name="RunUsageText" Text="{Binding UsageSummary}" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="RunSourcesList" ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Url}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
