<Window x:Class="PersonalAgent.App.ApprovalsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Action approvals" Height="760" Width="800" MinHeight="550" MinWidth="600"
        ShowActivated="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button x:Name="RefreshApprovalsButton" Content="Refresh" DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Padding="12,6" />
            <TextBlock Text="Review pending actions" FontSize="24" FontWeight="SemiBold" />
        </DockPanel>
        <TextBlock Grid.Row="1" x:Name="ApprovalMessage" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <ListBox x:Name="PendingApprovals" ItemsSource="{Binding Pending}" SelectedItem="{Binding Selected}"
                     DisplayMemberPath="Action.Description" IsEnabled="{Binding CanSelect}" Margin="0,0,12,0" />
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Action" FontWeight="SemiBold" />
                    <TextBlock x:Name="ApprovalDescription" Text="{Binding ActionDescription}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <TextBlock Text="Data destination / target" FontWeight="SemiBold" />
                    <TextBlock x:Name="ApprovalDestination" Text="{Binding Destination}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <TextBlock Text="Risk" FontWeight="SemiBold" />
                    <TextBlock x:Name="ApprovalRisk" Text="{Binding Risk}" Margin="0,4,0,12" />
                    <TextBlock Text="Tool and source" FontWeight="SemiBold" />
                    <TextBlock x:Name="ApprovalTool" Text="{Binding Tool}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <TextBlock Text="Exact arguments (untrusted data)" FontWeight="SemiBold" />
                    <TextBox x:Name="ApprovalArguments" Text="{Binding Arguments, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             MinHeight="130" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12" />
                    <TextBlock Text="Expires at" FontWeight="SemiBold" />
                    <TextBlock x:Name="ApprovalExpiry" Text="{Binding Expires}" Margin="0,4,0,12" />
                    <TextBlock Text="{Binding Correlation}" TextWrapping="Wrap" Foreground="DimGray" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <CheckBox x:Name="ApprovalAcknowledged" Content="I reviewed this action, its destination and exact arguments."
                      IsChecked="{Binding Acknowledged}" IsEnabled="{Binding CanDecide}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="DenyApprovalButton" Content="Deny" Command="{Binding DenyCommand}" Padding="20,8" Margin="0,0,12,0" />
                <Button x:Name="ApproveActionButton" Content="Approve this action once" Command="{Binding ApproveCommand}" Padding="20,8" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
